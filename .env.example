# Copy this file to `.env` and fill in your real key.
# `.env` is gitignored -- it never gets committed. This template is safe to commit.
#
# Voyage AI embedding API key (for Phase B vector retrieval).
# Get one at https://dashboard.voyageai.com/  ->  API Keys.
# VOYAGE_API_KEY is the exact name the voyageai Python SDK reads by default.
VOYAGE_API_KEY=your-key-here

# Anthropic API key (for the generation phase -- the LLM that writes cited
# answers). Get one at https://console.anthropic.com/  ->  API Keys.
# ANTHROPIC_API_KEY is the exact name the anthropic Python SDK reads by default.
ANTHROPIC_API_KEY=your-key-here

# OPTIONAL -- only needed to run the outside-judge eval (a non-Claude judge
# for the ablation harness, via OpenRouter). The app itself never uses it.
# Get one at https://openrouter.ai/  ->  Keys.
# OPENROUTER_API_KEY=your-key-here

# Slice 4 gated demo (rulesagent.demo_auth). Both are read once at import
# and must NOT be left unset in production -- the /unlock and /answer
# endpoints fail closed (503) without them, same as ADMIN_TOKEN below.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# DEMO_SESSION_SECRET=your-random-secret-here
# IP_HASH_SALT=your-random-salt-here

# Admin endpoints (scryfall refresh, demo code admin view). Unset -> 401/503,
# never silently open.
# ADMIN_TOKEN=your-random-token-here
