__pycache__/
*.pyc
.venv/
.env

# CR text and derived data — fetch/parse at build time, don't commit
data/raw/
data/parsed/
# demo telemetry (query + feedback logs) — never committed
data/logs/
# L3 (docs/plan-l3-sqlite-caches.md): SQLite cache/telemetry db + WAL sidecars
data/cache.db
data/cache.db-wal
data/cache.db-shm
!data/raw/.gitkeep
!data/parsed/.gitkeep

# job/agent scratch clones (e.g. TheJudge mined for prompt ideas) -- never commit
tmp/
